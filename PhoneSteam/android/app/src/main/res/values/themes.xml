<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ps_bg">#0F1218</color>
    <color name="ps_card">#1B2130</color>
    <color name="ps_accent">#66C0F4</color>
    <color name="ps_text">#E6EDF3</color>
    <color name="ps_muted">#8B98A9</color>

    <style name="Theme.PhoneSteam" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ps_accent</item>
        <item name="android:windowBackground">@color/ps_bg</item>
        <item name="android:statusBarColor">@color/ps_bg</item>
    </style>

    <style name="Theme.PhoneSteam.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="PsSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/ps_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
