{
    "jsonid": "input_profile",
    "controller_type": "phonesteam_controller",
    "device_class": "TrackedDeviceClass_Controller",
    "input_bindingui_mode": "controller_handed",
    "should_show_binding_errors": true,
    "legacy_binding": "{phonesteam}/input/legacy_bindings_phonesteam.json",
    "default_bindings": [],
    "input_source": {
        "/input/system": { "type": "button", "click": true, "binding_image_point": [34, 45], "order": 1 },
        "/input/application_menu": { "type": "button", "click": true, "binding_image_point": [34, 45], "order": 2 },
        "/input/a": { "type": "button", "click": true, "touch": true, "binding_image_point": [34, 45], "order": 3 },
        "/input/b": { "type": "button", "click": true, "touch": true, "binding_image_point": [34, 45], "order": 4 },
        "/input/trigger": { "type": "trigger", "click": true, "touch": true, "value": true, "binding_image_point": [34, 45], "order": 5 },
        "/input/grip": { "type": "trigger", "click": true, "touch": true, "value": true, "binding_image_point": [34, 45], "order": 6 },
        "/input/joystick": { "type": "joystick", "click": true, "touch": true, "binding_image_point": [34, 45], "order": 7 },
        "/pose/raw": { "type": "pose", "binding_image_point": [34, 45] },
        "/output/haptic": { "type": "vibration", "binding_image_point": [34, 45] }
    }
}
